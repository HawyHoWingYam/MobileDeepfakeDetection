\@writefile{lot}{\contentsline {table}{\numberline {24}{\ignorespaces Per-generator performance breakdown on FaceForensics++ test split. Stage~2 EfficientNetV2-B3 calibrated model. Results show that GAN-based methods (Deepfakes, FaceSwap) are easier to detect than neural rendering techniques (NeuralTextures).}}{52}{table.caption.104}\protected@file@percent }
\newlabel{tab:per_generator_appendix}{{24}{52}{Per-generator performance breakdown on FaceForensics++ test split. Stage~2 EfficientNetV2-B3 calibrated model. Results show that GAN-based methods (Deepfakes, FaceSwap) are easier to detect than neural rendering techniques (NeuralTextures)}{table.caption.104}{}}
\@writefile{lot}{\contentsline {table}{\numberline {25}{\ignorespaces Per-dataset optimal Stage~1 thresholds at target recall = 0.95. Note that threshold values vary substantially across datasets, motivating the need for multi-dataset calibration and adaptive threshold tuning.}}{52}{table.caption.109}\protected@file@percent }
\newlabel{tab:per_dataset_threshold_appendix}{{25}{52}{Per-dataset optimal Stage~1 thresholds at target recall = 0.95. Note that threshold values vary substantially across datasets, motivating the need for multi-dataset calibration and adaptive threshold tuning}{table.caption.109}{}}
\@writefile{lot}{\contentsline {table}{\numberline {26}{\ignorespaces Calibration transfer analysis. ECE measured on test sets when applying temperature learned on FaceForensics++ validation vs.\ dataset-specific temperature. Lower ECE indicates better calibration. Results show modest degradation (ECE +1--2\%) when transferring calibration across datasets, supporting our multi-dataset calibration approach.}}{52}{table.caption.113}\protected@file@percent }
\newlabel{tab:calibration_transfer_appendix}{{26}{52}{Calibration transfer analysis. ECE measured on test sets when applying temperature learned on FaceForensics++ validation vs.\ dataset-specific temperature. Lower ECE indicates better calibration. Results show modest degradation (ECE +1--2\%) when transferring calibration across datasets, supporting our multi-dataset calibration approach}{table.caption.113}{}}
\@writefile{lot}{\contentsline {table}{\numberline {27}{\ignorespaces Comparison of mobile export formats for Stage~1 and Stage~2 models. TorchScript provides a good balance of size and compatibility for PyTorch Mobile integration, while ONNX offers broader framework support with slightly larger artifacts.}}{52}{table.caption.115}\protected@file@percent }
\newlabel{tab:export_artifact_comparison_appendix}{{27}{52}{Comparison of mobile export formats for Stage~1 and Stage~2 models. TorchScript provides a good balance of size and compatibility for PyTorch Mobile integration, while ONNX offers broader framework support with slightly larger artifacts}{table.caption.115}{}}
