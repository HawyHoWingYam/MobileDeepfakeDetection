{
  "metadata": {
    "name": "celebdf_v2_dataset",
    "version": "1.0",
    "description": "CelebDF-v2 dataset configuration for AWARE-NET BCE training verification",
    "dataset_type": "deepfake_detection",
    "image_format": "jpg",
    "image_size": [256, 256],
    "created_at": "2025-09-20T16:30:00Z"
  },
  "data_paths": {
    "real": "dataset/real/CelebDF-v2",
    "fake": "dataset/fake/CelebDF-v2"
  },
  "splits": {
    "train": {
      "manifest_path": "manifests/celebdf_v2_train.csv",
      "ratio": 0.7,
      "min_samples": 1000
    },
    "val": {
      "manifest_path": "manifests/celebdf_v2_val.csv", 
      "ratio": 0.15,
      "min_samples": 100
    },
    "test": {
      "manifest_path": "manifests/celebdf_v2_test.csv",
      "ratio": 0.15,
      "min_samples": 100
    }
  },
  "model": {
    "architecture": "efficientnet_v2_b3",
    "num_classes": 1,
    "pretrained": true,
    "dropout_rate": 0.2
  },
  "training": {
    "loss_function": "bce_with_logits",
    "pos_weight": 5.84,
    "optimizer": "adamw",
    "learning_rate": 0.001,
    "weight_decay": 0.01,
    "batch_size": 32,
    "epochs": 50,
    "validation_split": 0.15,
    "test_split": 0.15,
    "seed": 42
  },
  "preprocessing": {
    "resize": [256, 256],
    "normalize": {
      "mean": [0.485, 0.456, 0.406],
      "std": [0.229, 0.224, 0.225]
    }
  },
  "augmentation": {
    "horizontal_flip": {
      "enabled": true,
      "probability": 0.5
    },
    "rotation": {
      "enabled": true,
      "range": [-10, 10]
    },
    "color_jitter": {
      "enabled": true,
      "brightness": 0.2,
      "contrast": 0.2,
      "saturation": 0.2,
      "hue": 0.1
    },
    "gaussian_blur": {
      "enabled": true,
      "kernel_size": 5,
      "sigma": [0.1, 2.0]
    }
  }
}