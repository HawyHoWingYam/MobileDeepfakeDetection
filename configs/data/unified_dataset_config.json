{
  "metadata": {
    "name": "unified_deepfake_detection_dataset",
    "version": "1.0",
    "description": "Unified configuration for CelebDF-v2, FF++, and DeeperForensics-1.0 datasets for AWARE-NET BCE training",
    "dataset_type": "unified_multi_dataset",
    "datasets_included": [
      "celebdf_v2",
      "faceforensics_plus_plus", 
      "deeperforensics_1_0"
    ],
    "total_samples": 3701283,
    "real_samples": 812143,
    "fake_samples": 2889140,
    "image_format": "jpg",
    "image_size": [256, 256],
    "created_at": "2025-09-20T16:22:00Z",
    "last_updated": "2025-09-20T16:22:00Z"
  },
  "datasets": {
    "celebdf_v2": {
      "enabled": true,
      "config_path": "configs/dataset_paths.json",
      "weight": 0.15,
      "description": "CelebDF-v2 - Balanced real/fake celebrity faces",
      "samples": {
        "total": 407712,
        "real": 59557,
        "fake": 348155,
        "real_percentage": 14.6,
        "fake_percentage": 85.4
      },
      "manifests": {
        "train": "manifests/celebdf_v2_train.csv",
        "val": "manifests/celebdf_v2_val.csv", 
        "test": "manifests/celebdf_v2_test.csv"
      }
    },
    "faceforensics_plus_plus": {
      "enabled": true,
      "config_path": "configs/faceforensics_config.json",
      "weight": 0.35,
      "description": "FF++ - Largest fake dataset with multiple generation methods",
      "samples": {
        "total": 745609,
        "real": 161014,
        "fake": 584595,
        "real_percentage": 21.6,
        "fake_percentage": 78.4
      },
      "manifests": {
        "train": "manifests/faceforensics_train.csv",
        "val": "manifests/faceforensics_val.csv",
        "test": "manifests/faceforensics_test.csv"
      }
    },
    "deeperforensics_1_0": {
      "enabled": true,
      "config_path": "configs/deeperforensics_config.json", 
      "weight": 0.5,
      "description": "DeeperForensics-1.0 - High quality diverse fake and real data",
      "samples": {
        "total": 1548061,
        "real": 591572,
        "fake": 956489,
        "real_percentage": 38.2,
        "fake_percentage": 61.8
      },
      "manifests": {
        "train": "manifests/deeperforensics_train.csv",
        "val": "manifests/deeperforensics_val.csv",
        "test": "manifests/deeperforensics_test.csv"
      }
    }
  },
  "combined_statistics": {
    "total_samples": 2701382,
    "total_real": 812143,
    "total_fake": 1889239,
    "real_percentage": 30.1,
    "fake_percentage": 69.9,
    "class_imbalance_ratio": 2.33
  },
  "sampling_strategy": {
    "method": "weighted_stratified",
    "balance_datasets": true,
    "balance_classes": true,
    "oversampling": {
      "enabled": true,
      "target_class": "real",
      "strategy": "random_oversample"
    },
    "class_weights": {
      "real": 2.33,
      "fake": 1.0,
      "auto_calculate": true
    }
  },
  "data_loading": {
    "unified_manifests": {
      "train": [
        "manifests/celebdf_v2_train.csv",
        "manifests/faceforensics_train.csv",
        "manifests/deeperforensics_train.csv"
      ],
      "val": [
        "manifests/celebdf_v2_val.csv", 
        "manifests/faceforensics_val.csv",
        "manifests/deeperforensics_val.csv"
      ],
      "test": [
        "manifests/celebdf_v2_test.csv",
        "manifests/faceforensics_test.csv", 
        "manifests/deeperforensics_test.csv"
      ]
    },
    "batch_composition": {
      "celebdf_v2_ratio": 0.15,
      "faceforensics_ratio": 0.35,
      "deeperforensics_ratio": 0.5
    }
  },
  "preprocessing": {
    "resize": true,
    "normalize": true,
    "target_size": [256, 256],
    "standardization": {
      "mean": [0.485, 0.456, 0.406],
      "std": [0.229, 0.224, 0.225]
    },
    "augmentation": {
      "enabled": true,
      "training_only": true,
      "transforms": {
        "horizontal_flip": 0.5,
        "rotation": 15,
        "color_jitter": {
          "brightness": 0.1,
          "contrast": 0.1,
          "saturation": 0.1,
          "hue": 0.05
        },
        "gaussian_blur": 0.1,
        "random_erasing": 0.1
      }
    }
  },
  "training": {
    "batch_size": 32,
    "num_workers": 4,
    "pin_memory": true,
    "drop_last": true,
    "shuffle": true,
    "loss_function": "BCEWithLogitsLoss",
    "pos_weight": 2.33,
    "num_epochs": 50,
    "learning_rate": 0.001,
    "weight_decay": 0.01,
    "use_class_weights": true,
    "early_stopping_patience": 10,
    "save_checkpoints": true
  },
  "validation": {
    "cross_dataset": true,
    "within_dataset": true,
    "metrics": [
      "accuracy",
      "auc",
      "f1_score", 
      "precision",
      "recall",
      "average_precision"
    ]
  }
}