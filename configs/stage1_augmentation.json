{
  "metadata": {
    "name": "Stage1_Augmentation_Policy",
    "description": "Data augmentation strategies optimized for SupCon contrastive learning",
    "version": "1.0.0",
    "created_for": "SupCon authenticity modeling"
  },
  "augmentation_policies": {
    "contrastive_learning": {
      "description": "Strong augmentations for contrastive learning",
      "enabled": true,
      "transforms": [
        {
          "name": "RandomResizedCrop",
          "size": 256,
          "scale": [0.8, 1.0],
          "ratio": [0.9, 1.1],
          "probability": 1.0,
          "order": 1
        },
        {
          "name": "RandomHorizontalFlip",
          "probability": 0.5,
          "order": 2
        },
        {
          "name": "ColorJitter",
          "brightness": 0.4,
          "contrast": 0.4,
          "saturation": 0.4,
          "hue": 0.1,
          "probability": 0.8,
          "order": 3
        },
        {
          "name": "RandomGrayscale",
          "probability": 0.2,
          "order": 4
        },
        {
          "name": "GaussianBlur",
          "kernel_size": [3, 23],
          "sigma": [0.1, 2.0],
          "probability": 0.5,
          "order": 5
        },
        {
          "name": "RandomApply",
          "transforms": ["GaussianBlur"],
          "probability": 0.5,
          "order": 6
        }
      ]
    },
    "minimal_baseline": {
      "description": "Minimal augmentations for baseline comparison",
      "enabled": false,
      "transforms": [
        {
          "name": "Resize",
          "size": 256,
          "order": 1
        },
        {
          "name": "CenterCrop",
          "size": 256,
          "order": 2
        },
        {
          "name": "RandomHorizontalFlip",
          "probability": 0.5,
          "order": 3
        }
      ]
    },
    "evaluation": {
      "description": "Augmentations for evaluation/inference",
      "enabled": true,
      "transforms": [
        {
          "name": "Resize",
          "size": 256,
          "order": 1
        },
        {
          "name": "CenterCrop",
          "size": 256,
          "order": 2
        }
      ]
    }
  },
  "normalization": {
    "mean": [0.485, 0.456, 0.406],
    "std": [0.229, 0.224, 0.225],
    "description": "ImageNet normalization parameters"
  },
  "sampling_strategy": {
    "type": "balanced_class_sampling",
    "parameters": {
      "min_samples_per_class": 4,
      "max_samples_per_class": 16,
      "ensure_balance": true,
      "shuffle": true,
      "drop_last": true
    },
    "batch_construction": {
      "strategy": "contrastive_pairs",
      "positive_pair_ratio": 0.5,
      "negative_pair_ratio": 0.5,
      "minimum_pairs": 8
    }
  },
  "quality_checks": {
    "image_validation": {
      "min_size": [224, 224],
      "max_size": [1024, 1024],
      "valid_formats": ["jpg", "jpeg", "png"],
      "corruption_detection": true
    },
    "augmentation_validation": {
      "preserve_aspect_ratio": true,
      "quality_threshold": 0.9,
      "artifact_detection": true
    }
  },
  "ablation_configurations": {
    "no_augmentation": {
      "transforms": ["Resize", "CenterCrop", "ToTensor", "Normalize"]
    },
    "weak_augmentation": {
      "transforms": ["RandomResizedCrop", "RandomHorizontalFlip", "ToTensor", "Normalize"]
    },
    "medium_augmentation": {
      "transforms": ["RandomResizedCrop", "RandomHorizontalFlip", "ColorJitter", "ToTensor", "Normalize"]
    },
    "strong_augmentation": {
      "transforms": ["RandomResizedCrop", "RandomHorizontalFlip", "ColorJitter", "RandomGrayscale", "GaussianBlur", "ToTensor", "Normalize"]
    }
  },
  "performance_optimization": {
    "num_workers": 4,
    "pin_memory": true,
    "prefetch_factor": 2,
    "persistent_workers": true,
    "multiprocessing_context": "spawn"
  },
  "theoretical_justification": {
    "contrastive_learning_requirements": [
      "Strong augmentations create diverse positive pairs",
      "Color jittering preserves semantic content while changing appearance",
      "Gaussian blur reduces low-level texture dependencies",
      "Random crop focuses on different regions of authenticity"
    ],
    "authenticity_modeling_considerations": [
      "Preserve facial structure and identity",
      "Maintain temporal consistency cues",
      "Avoid artifacts that could confuse detection",
      "Balance between invariance and discrimination"
    ]
  }
}