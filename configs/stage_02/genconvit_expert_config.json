{
  "metadata": {
    "name": "GenConViT_Generative_Expert",
    "description": "Configuration for GenConViT generative structure detection expert",
    "version": "1.0.0",
    "expert_type": "generative",
    "stage": "stage_02"
  },
  "model_architecture": {
    "backbone": {
      "convnext_variant": "convnext_small",
      "swin_variant": "swin_small_patch4_window7_224",
      "pretrained": true,
      "feature_fusion_dim": 768,
      "cross_attention_layers": 2
    },
    "reconstruction_head": {
      "decoder_type": "vae",
      "latent_dim": 256,
      "reconstruction_loss": "l1_perceptual",
      "kl_weight": 0.001,
      "perceptual_weight": 0.1
    },
    "classification_head": {
      "num_classes": 1,
      "dropout_rate": 0.3,
      "hidden_dims": [512, 256]
    },
    "dual_task_weighting": {
      "classification_weight": 0.7,
      "reconstruction_weight": 0.3,
      "adaptive_weighting": true
    }
  },
  "multi_resolution_support": {
    "supported_resolutions": [224, 256, 288, 320],
    "default_resolution": 256,
    "adaptive_resolution": true,
    "patch_size_adaptation": true,
    "aspect_ratio_preservation": true,
    "resize_interpolation": "bicubic"
  },
  "generative_specialization": {
    "reconstruction_quality_analysis": {
      "enabled": true,
      "ssim_threshold": 0.85,
      "lpips_threshold": 0.15,
      "multi_scale_ssim": true,
      "perceptual_distance_network": "vgg16"
    },
    "frequency_domain_analysis": {
      "enabled": true,
      "dct_analysis": true,
      "wavelet_analysis": false,
      "frequency_band_attention": true,
      "high_freq_artifact_detection": true
    },
    "generative_artifact_detection": {
      "enabled": true,
      "gan_artifact_patterns": true,
      "diffusion_noise_patterns": true,
      "upsampling_artifact_detection": true,
      "color_channel_inconsistency": true
    },
    "temporal_consistency": {
      "enabled": false,
      "note": "Reserved for Stage 03 temporal expert integration"
    }
  },
  "progressive_validation": {
    "concept_validation": {
      "model_variant": "convnext_small_swin_small",
      "resolution": 256,
      "sample_size": 1000,
      "epochs": 15,
      "batch_size": 24,
      "target_metrics": {
        "min_auc": 0.90,
        "reconstruction_quality_auc": 0.93,
        "generative_artifact_auc": 0.91,
        "baseline_improvement": 0.02,
        "max_inference_time_ms": 150
      }
    },
    "architecture_comparison": {
      "variants_to_test": [
        {"convnext": "convnext_small", "swin": "swin_small_patch4_window7_224"},
        {"convnext": "convnext_tiny", "swin": "swin_tiny_patch4_window7_224"},
        {"convnext": "convnext_base", "swin": "swin_base_patch4_window7_224"}
      ],
      "decoder_variants": ["vae", "standard_ed"],
      "samples_per_variant": 500,
      "efficiency_weight": 0.4,
      "quality_weight": 0.6
    },
    "dual_task_optimization": {
      "task_weight_ranges": {
        "classification": [0.5, 0.6, 0.7, 0.8],
        "reconstruction": [0.2, 0.3, 0.4, 0.5]
      },
      "adaptive_weighting_strategies": ["fixed", "dynamic", "curriculum"],
      "reconstruction_loss_variants": ["l1", "l2", "l1_perceptual", "ssim_l1"]
    }
  },
  "training_optimization": {
    "graduated_learning_rates": {
      "enabled": true,
      "convnext_lr_multiplier": 0.1,
      "swin_lr_multiplier": 0.1,
      "fusion_lr_multiplier": 1.0,
      "decoder_lr_multiplier": 1.0,
      "classifier_lr_multiplier": 1.0,
      "warmup_epochs": 5
    },
    "loss_configuration": {
      "classification_loss": "focal_loss",
      "focal_alpha": 0.25,
      "focal_gamma": 2.0,
      "reconstruction_losses": {
        "l1_loss": {"weight": 0.5},
        "perceptual_loss": {"weight": 0.3, "layers": ["relu1_2", "relu2_2", "relu3_3"]},
        "ssim_loss": {"weight": 0.2}
      },
      "regularization_losses": {
        "kl_divergence": {"weight": 0.001},
        "feature_consistency": {"weight": 0.05}
      }
    },
    "regularization": {
      "dropout_rate": 0.3,
      "weight_decay": 1e-4,
      "stochastic_depth": 0.2,
      "mixup_alpha": 0.1,
      "cutmix_alpha": 0.5,
      "reconstruction_consistency_reg": 0.1
    },
    "data_augmentation": {
      "generative_artifact_preserving": true,
      "reconstruction_quality_preserving": true,
      "augmentation_strategies": {
        "geometric": {
          "horizontal_flip": 0.5,
          "rotation_degrees": 3,
          "scale_range": [0.95, 1.0],
          "shear_range": [-1, 1]
        },
        "photometric": {
          "brightness": 0.05,
          "contrast": 0.05,
          "saturation": 0.05,
          "hue": 0.02
        },
        "generative_preserving": {
          "gaussian_noise": {
            "enabled": true,
            "std": 0.005,
            "probability": 0.2
          },
          "jpeg_compression": {
            "enabled": true,
            "quality_range": [85, 100],
            "probability": 0.3
          }
        }
      }
    }
  },
  "inference_optimization": {
    "mixed_precision": {
      "enabled": true,
      "amp_level": "O1"
    },
    "batch_processing": {
      "optimal_batch_sizes": {
        "224": 32,
        "256": 24,
        "288": 16,
        "320": 12
      },
      "dynamic_batching": true,
      "memory_efficient_attention": true,
      "reconstruction_batch_optimization": true
    },
    "model_optimization": {
      "torch_script": true,
      "onnx_export": true,
      "quantization_ready": true,
      "pruning_compatible": false,
      "note": "Reconstruction head makes pruning complex"
    }
  },
  "evaluation_metrics": {
    "primary_metrics": [
      "auc", "f1_score", "precision", "recall",
      "inference_time_ms", "memory_usage_mb"
    ],
    "generative_specialization_metrics": [
      "reconstruction_quality_auc",
      "generative_artifact_detection_auc",
      "frequency_domain_detection_auc",
      "gan_vs_diffusion_discrimination_auc"
    ],
    "reconstruction_metrics": [
      "ssim_score",
      "lpips_distance",
      "psnr_score",
      "perceptual_quality_score"
    ],
    "efficiency_metrics": [
      "throughput_images_per_second",
      "latency_p50_ms",
      "latency_p95_ms",
      "memory_peak_mb",
      "reconstruction_overhead_ms"
    ],
    "complementarity_metrics": [
      "correlation_with_spatial_expert",
      "correlation_with_stage01",
      "error_pattern_overlap",
      "ensemble_improvement_score"
    ]
  },
  "visualization_tools": {
    "reconstruction_visualization": {
      "enabled": true,
      "save_input_output_pairs": true,
      "difference_heatmaps": true,
      "quality_score_overlay": true
    },
    "attention_visualization": {
      "enabled": true,
      "cross_attention_maps": true,
      "feature_fusion_visualization": true,
      "patch_importance_heatmaps": true
    },
    "artifact_localization": {
      "enabled": true,
      "frequency_domain_visualization": true,
      "generative_artifact_heatmaps": true,
      "comparative_analysis_plots": true
    }
  },
  "baseline_comparison": {
    "stage_00_efficientnetv2_b3": {
      "reference_auc": 0.89,
      "reference_inference_ms": 85,
      "target_improvement": 0.02,
      "reconstruction_baseline": false
    },
    "stage_01_mobilenetv4": {
      "reference_auc": 0.91,
      "reference_inference_ms": 50,
      "target_improvement": 0.01,
      "complementarity_target": 0.6
    },
    "stage_02_spatial_expert": {
      "expected_correlation": 0.3,
      "complementarity_target": 0.8,
      "ensemble_improvement_target": 0.03
    },
    "generative_detection_baselines": {
      "reconstruction_baselines": ["autoencoder_baseline", "vae_baseline"],
      "frequency_baselines": ["dct_classifier", "wavelet_classifier"],
      "generative_baselines": ["gan_detector", "diffusion_detector"]
    }
  },
  "professional_domain_validation": {
    "generative_model_types": {
      "gan_detection": {
        "target_auc": 0.93,
        "test_datasets": ["stylegan2", "stylegan3", "progressive_gan"],
        "evaluation_method": "reconstruction_quality_analysis"
      },
      "diffusion_detection": {
        "target_auc": 0.90,
        "test_datasets": ["dalle2", "midjourney", "stable_diffusion"],
        "evaluation_method": "noise_pattern_analysis"
      },
      "autoregressive_detection": {
        "target_auc": 0.88,
        "test_datasets": ["gpt_generated", "vq_gan"],
        "evaluation_method": "structure_consistency_analysis"
      }
    },
    "cross_manipulation_validation": {
      "deepfakes": 0.85,
      "face2face": 0.87,
      "faceswap": 0.88,
      "neuraltextures": 0.92,
      "note": "GenConViT should excel at neuraltextures due to generative nature"
    }
  },
  "resource_constraints": {
    "training_resources": {
      "max_gpu_memory_gb": 10,
      "recommended_batch_size": 24,
      "estimated_training_hours": 18,
      "checkpoint_frequency": 5,
      "reconstruction_memory_overhead": 40
    },
    "inference_resources": {
      "max_inference_time_ms": 150,
      "target_inference_time_ms": 120,
      "max_memory_mb": 2000,
      "target_memory_mb": 1600,
      "reconstruction_optional": true
    },
    "storage_requirements": {
      "model_size_mb": 35,
      "checkpoint_size_mb": 45,
      "config_size_kb": 8,
      "visualization_artifacts_mb": 100,
      "reconstruction_samples_mb": 200
    }
  },
  "integration_specifications": {
    "unified_feature_extractor": {
      "feature_dimension": 768,
      "normalized_features": true,
      "standardized_output_format": true,
      "expert_type_annotation": "generative",
      "reconstruction_features_optional": true
    },
    "heterogeneous_system": {
      "parallel_inference_compatible": true,
      "memory_sharing_optimized": false,
      "feature_fusion_ready": true,
      "cascade_system_compatible": true,
      "reconstruction_cache_compatible": true
    },
    "stage_03_preparation": {
      "temporal_expert_integration": true,
      "feature_alignment": true,
      "three_expert_system_ready": true,
      "temporal_reconstruction_ready": false
    }
  },
  "quality_assurance": {
    "automated_testing": {
      "unit_tests": true,
      "integration_tests": true,
      "performance_regression_tests": true,
      "memory_leak_tests": true,
      "reconstruction_quality_tests": true
    },
    "validation_pipeline": {
      "statistical_significance_testing": true,
      "cross_validation": true,
      "holdout_test_validation": true,
      "baseline_comparison_automated": true,
      "reconstruction_ablation_studies": true
    },
    "monitoring": {
      "training_metrics_logging": true,
      "inference_performance_monitoring": true,
      "resource_usage_tracking": true,
      "reconstruction_quality_monitoring": true,
      "dual_task_balance_monitoring": true
    }
  },
  "deployment_readiness": {
    "model_export_formats": ["pytorch", "onnx", "torchscript"],
    "quantization_support": ["int8", "fp16"],
    "mobile_optimization": false,
    "batch_inference_optimization": true,
    "real_time_inference_capable": false,
    "reconstruction_head_optional": true,
    "note": "Reconstruction head can be disabled for faster inference"
  }
}