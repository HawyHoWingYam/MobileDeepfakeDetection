{
  "metadata": {
    "name": "Stage02_Data_Manifest",
    "description": "Data manifest and resource planning for Stage 02 heterogeneous expert models",
    "version": "1.0.0",
    "created_date": "2025-09-23",
    "stage": "stage_02",
    "compatible_with": ["stage_01", "stage_00"]
  },
  "data_configuration": {
    "base_dataset_config": {
      "reference_config": "configs/unified_dataset_config.json",
      "resolution_splits": {
        "description": "Multi-resolution data splits for expert training and validation",
        "224x224": {
          "enabled": true,
          "use_case": "efficiency_testing",
          "sample_ratio": 0.1
        },
        "256x256": {
          "enabled": true,
          "use_case": "primary_training",
          "sample_ratio": 1.0,
          "note": "Standard resolution matching existing data"
        },
        "288x288": {
          "enabled": true,
          "use_case": "resolution_comparison",
          "sample_ratio": 0.2
        },
        "320x320": {
          "enabled": true,
          "use_case": "high_detail_validation",
          "sample_ratio": 0.1
        }
      }
    },
    "expert_specific_splits": {
      "spatial_expert": {
        "description": "EfficientNetV2-B0 spatial artifact detection specialization",
        "focus_manipulations": [
          "edge_blending",
          "face_swap",
          "face_reenactment",
          "texture_inconsistencies",
          "spatial_artifacts"
        ],
        "sample_distribution": {
          "concept_validation": {
            "samples_per_class": 500,
            "total_samples": 1000,
            "balanced": true,
            "manipulation_coverage": "all_spatial_types"
          },
          "resolution_comparison": {
            "samples_per_resolution": 500,
            "resolutions": [224, 256, 288, 320],
            "total_samples": 2000
          },
          "full_training": {
            "training_samples": 50000,
            "validation_samples": 10000,
            "test_samples": 5000,
            "note": "Training phase - handled separately"
          }
        },
        "augmentation_alignment": {
          "preserve_spatial_artifacts": true,
          "edge_preservation_ratio": 0.9,
          "texture_consistency_check": true
        }
      },
      "generative_expert": {
        "description": "GenConViT generative structure analysis specialization",
        "focus_manipulations": [
          "gan_generated",
          "diffusion_generated",
          "stylegan_samples",
          "deepfake_videos",
          "synthetic_faces"
        ],
        "sample_distribution": {
          "dual_task_validation": {
            "samples_per_task": 500,
            "total_samples": 1000,
            "classification_samples": 500,
            "reconstruction_samples": 500
          },
          "reconstruction_quality_test": {
            "real_samples": 1000,
            "fake_samples": 1000,
            "ssim_baseline_required": true
          }
        },
        "reconstruction_requirements": {
          "input_resolution": 256,
          "output_resolution": 256,
          "quality_metrics": ["ssim", "lpips", "mse"],
          "real_image_ssim_target": 0.85,
          "fake_image_ssim_target": 0.70
        }
      }
    },
    "baseline_alignment": {
      "stage_01_compatibility": {
        "shared_validation_set": true,
        "feature_extraction_alignment": true,
        "metric_consistency": [
          "auc", "f1_score", "precision", "recall",
          "inference_time_ms", "memory_usage_mb"
        ]
      },
      "stage_00_baseline": {
        "reference_metrics": {
          "efficientnetv2_b3_auc": 0.89,
          "efficientnetv2_b3_inference_ms": 85,
          "target_improvement": 0.03
        },
        "comparison_dataset": "same_test_split"
      }
    }
  },
  "resource_planning": {
    "compute_requirements": {
      "progressive_validation": {
        "phase_1_concept_validation": {
          "estimated_time_hours": 8,
          "gpu_memory_gb": 6,
          "batch_size": 32,
          "concurrent_experiments": 1,
          "total_gpu_hours": 8
        },
        "phase_2_resolution_comparison": {
          "estimated_time_hours": 4,
          "gpu_memory_gb": 8,
          "resolutions_tested": 4,
          "parallel_possible": true,
          "total_gpu_hours": 16
        },
        "phase_3_upgrade_decision": {
          "estimated_time_hours": 2,
          "analysis_only": true,
          "gpu_requirements": "minimal"
        }
      },
      "spatial_expert_development": {
        "architecture_implementation": {
          "time_estimate_hours": 16,
          "gpu_requirements": "development_testing",
          "memory_profiling": true
        },
        "validation_experiments": {
          "time_estimate_hours": 12,
          "gpu_memory_gb": 8,
          "parallel_resolution_tests": true
        }
      },
      "genconvit_expert_development": {
        "architecture_implementation": {
          "time_estimate_hours": 24,
          "complexity": "high_dual_task",
          "gpu_memory_gb": 10,
          "reconstruction_memory_overhead": 2
        },
        "dual_task_validation": {
          "time_estimate_hours": 16,
          "classification_task_hours": 8,
          "reconstruction_task_hours": 8,
          "joint_training_validation": 4
        }
      },
      "integration_testing": {
        "unified_interface_testing": {
          "time_estimate_hours": 8,
          "multi_expert_memory_gb": 12,
          "parallel_inference_testing": true
        },
        "complementarity_analysis": {
          "time_estimate_hours": 6,
          "correlation_analysis": true,
          "fusion_prototyping": true
        }
      }
    },
    "storage_requirements": {
      "dataset_storage": {
        "multi_resolution_datasets": {
          "224x224_gb": 5,
          "256x256_gb": 8,
          "288x288_gb": 12,
          "320x320_gb": 18,
          "total_gb": 43
        },
        "expert_specific_splits": {
          "spatial_expert_gb": 15,
          "generative_expert_gb": 15,
          "shared_validation_gb": 5,
          "total_gb": 35
        }
      },
      "model_artifacts": {
        "checkpoints_per_expert": 10,
        "checkpoint_size_gb": 0.5,
        "total_checkpoints_gb": 10,
        "experiment_logs_gb": 2,
        "visualization_artifacts_gb": 3
      },
      "total_storage_gb": 93
    },
    "memory_profiling": {
      "single_expert_inference": {
        "efficientnetv2_b0_mb": 800,
        "genconvit_ed_mb": 1200,
        "genconvit_vae_mb": 1400,
        "stage_01_mobilenetv4_mb": 600
      },
      "multi_expert_parallel": {
        "dual_expert_mb": 2200,
        "triple_expert_with_stage01_mb": 2800,
        "memory_overhead_mb": 500,
        "safe_limit_gb": 8
      },
      "batch_processing": {
        "batch_size_recommendations": {
          "single_expert": 64,
          "dual_expert": 32,
          "triple_expert": 16
        },
        "dynamic_batching": true
      }
    }
  },
  "validation_data_requirements": {
    "progressive_validation_datasets": {
      "concept_validation_set": {
        "size": 1000,
        "balanced": true,
        "manipulation_types": "spatial_focus",
        "baseline_comparison_required": true
      },
      "resolution_comparison_set": {
        "size_per_resolution": 500,
        "total_size": 2000,
        "fixed_content": true,
        "quality_controlled": true
      },
      "heterogeneous_validation_set": {
        "size": 2000,
        "spatial_specialization_samples": 500,
        "generative_specialization_samples": 500,
        "mixed_manipulation_samples": 1000
      }
    },
    "baseline_comparison_data": {
      "stage_01_shared_set": {
        "size": 5000,
        "feature_extraction_ready": true,
        "rapid_filter_predictions_available": true
      },
      "stage_00_reference_set": {
        "size": 10000,
        "efficientnetv2_b3_predictions_available": true,
        "ground_truth_verified": true
      }
    }
  },
  "data_quality_assurance": {
    "consistency_checks": {
      "resolution_integrity": {
        "check_aspect_ratios": true,
        "verify_upsampling_quality": true,
        "ensure_no_artifacts_from_resize": true
      },
      "manipulation_coverage": {
        "verify_spatial_artifact_presence": true,
        "check_generative_quality_metrics": true,
        "ensure_balanced_difficulty_distribution": true
      },
      "baseline_alignment": {
        "same_samples_across_stages": true,
        "consistent_preprocessing": true,
        "verified_ground_truth": true
      }
    },
    "data_validation_pipeline": {
      "automated_checks": [
        "image_integrity",
        "resolution_verification",
        "manipulation_type_verification",
        "ground_truth_consistency"
      ],
      "manual_review": {
        "sample_size": 100,
        "expert_verification": true,
        "quality_scoring": true
      }
    }
  },
  "experiment_tracking_integration": {
    "wandb_configuration": {
      "project": "AWARE-NET-Stage02",
      "entity": null,
      "group": "Heterogeneous-Experts",
      "tags": [
        "stage_02",
        "spatial_expert",
        "genconvit",
        "progressive_validation",
        "multi_resolution"
      ]
    },
    "data_versioning": {
      "track_dataset_versions": true,
      "hash_verification": true,
      "lineage_tracking": true
    },
    "artifact_management": {
      "checkpoint_tracking": true,
      "config_versioning": true,
      "result_archival": true
    }
  },
  "compliance_and_documentation": {
    "data_usage_compliance": {
      "research_only": true,
      "no_redistribution": true,
      "academic_purposes": true
    },
    "documentation_requirements": {
      "data_manifest_updates": "real_time",
      "experiment_documentation": "comprehensive",
      "resource_usage_logging": "detailed"
    },
    "reproducibility": {
      "seed_management": true,
      "environment_specification": true,
      "exact_data_splits": true
    }
  }
}