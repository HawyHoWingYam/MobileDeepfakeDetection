{
  "metadata": {
    "name": "AWARE-NET Master Configuration",
    "description": "Unified configuration for all AWARE-NET project settings",
    "version": "1.0.0",
    "created_at": "2025-09-24",
    "consolidates": [
      "training_config.json",
      "experiment_tracking.json",
      "mobile_deploy_config.json"
    ]
  },
  "global_settings": {
    "project_name": "AWARE-NET",
    "image_size": [256, 256],
    "num_classes": 1,
    "seed": 42,
    "deterministic": true
  },
  "preprocessing": {
    "normalize": {
      "mean": [0.485, 0.456, 0.406],
      "std": [0.229, 0.224, 0.225]
    },
    "resize": [256, 256],
    "dtype": "float32"
  },
  "training": {
    "defaults": {
      "batch_size": 32,
      "num_epochs": 50,
      "learning_rate": 0.001,
      "weight_decay": 0.0001,
      "num_workers": 4,
      "early_stopping_patience": 10,
      "gradient_clipping": 1.0,
      "warmup_epochs": 5
    },
    "optimization": {
      "optimizer": "adamw",
      "scheduler": "cosine",
      "mixed_precision": true,
      "use_class_weights": true
    },
    "monitoring": {
      "log_interval": 100,
      "save_interval": 5,
      "eval_interval": 1
    }
  },
  "model": {
    "defaults": {
      "pretrained": true,
      "dropout_rate": 0.2,
      "freeze_backbone": false
    },
    "architectures": {
      "baseline": {
        "name": "tf_efficientnetv2_b3",
        "description": "Stage 0 baseline model"
      },
      "stage_01": {
        "name": "MobileNetV4-Hybrid-Medium",
        "description": "SupCon rapid filter"
      },
      "stage_02_spatial": {
        "name": "efficientnetv2_b0",
        "description": "Spatial artifact expert"
      },
      "stage_02_generative": {
        "name": "GenConViT",
        "description": "Generative structure expert"
      }
    }
  },
  "experiment_tracking": {
    "enabled": true,
    "primary_tracker": "wandb",
    "fallback_tracker": "mlflow",
    "local_logging": true,
    "wandb_config": {
      "project": "AWARE-NET",
      "group": "unified-project",
      "tags": [
        "deepfake-detection",
        "academic-research",
        "mobile-deployment"
      ],
      "config": {
        "track_gradients": true,
        "track_parameters": true,
        "track_artifacts": true,
        "save_code": true,
        "monitor_gpu": true,
        "log_frequency": 10
      }
    },
    "mlflow_config": {
      "tracking_uri": "file:./mlruns",
      "experiment_name": "AWARE-NET-Unified",
      "artifact_location": "./mlflow_artifacts",
      "auto_log": false
    }
  },
  "reproducibility": {
    "seed_policy": {
      "global_seed": 42,
      "deterministic_algorithms": true,
      "benchmark_mode": false,
      "numpy_seed": 42,
      "random_seed": 42,
      "torch_manual_seed": 42,
      "cuda_manual_seed": 42,
      "cuda_manual_seed_all": 42
    },
    "environment_tracking": {
      "python_version": true,
      "pytorch_version": true,
      "cuda_version": true,
      "gpu_info": true,
      "system_info": true,
      "package_versions": [
        "torch",
        "timm",
        "sklearn",
        "numpy",
        "pandas",
        "matplotlib",
        "seaborn",
        "albumentations",
        "opencv-python"
      ]
    }
  },
  "mobile_deployment": {
    "performance_targets": {
      "inference_time": {
        "max_ms_per_image": 50,
        "target_ms_per_image": 30
      },
      "memory_usage": {
        "max_peak_mb": 2048,
        "target_peak_mb": 1536,
        "model_size_max_mb": 50,
        "model_size_target_mb": 30
      },
      "accuracy_retention": {
        "min_auc_retention": 0.95,
        "target_auc_retention": 0.98,
        "calibration_ece_max": 0.08
      }
    },
    "optimization": {
      "quantization": {
        "enabled": true,
        "method": "post_training_quantization",
        "precision": "int8",
        "calibration_dataset_size": 1000
      },
      "pruning": {
        "enabled": true,
        "method": "magnitude_based",
        "sparsity_target": 0.3,
        "fine_tune_after_pruning": true
      }
    },
    "deployment_formats": {
      "onnx": {
        "enabled": true,
        "opset_version": 14,
        "optimize_for_mobile": true
      },
      "torchscript": {
        "enabled": true,
        "optimization_level": 3,
        "mobile_optimization": true
      }
    },
    "device_profiles": {
      "high_end_mobile": {
        "inference_time_ms": 25,
        "memory_mb": 1024,
        "input_size": [256, 256]
      },
      "mid_range_mobile": {
        "inference_time_ms": 40,
        "memory_mb": 1536,
        "input_size": [224, 224]
      },
      "edge_device": {
        "inference_time_ms": 50,
        "memory_mb": 512,
        "input_size": [192, 192]
      }
    }
  },
  "artifact_management": {
    "model_checkpoints": {
      "save_frequency": 5,
      "save_best_only": false,
      "save_top_k": 3,
      "monitor_metric": "val_auc",
      "mode": "max",
      "filename_pattern": "{stage}_epoch_{epoch:02d}_auc_{val_auc:.4f}.pth"
    },
    "evaluation_artifacts": {
      "confusion_matrices": true,
      "roc_curves": true,
      "pr_curves": true,
      "calibration_plots": true,
      "feature_space_visualizations": true
    },
    "configuration_snapshots": {
      "model_config": true,
      "training_config": true,
      "data_config": true,
      "experiment_config": true
    }
  },
  "logging_schema": {
    "metrics": {
      "training": [
        "epoch",
        "step",
        "learning_rate",
        "loss",
        "gradient_norm",
        "batch_time",
        "data_loading_time"
      ],
      "validation": [
        "val_auc",
        "val_f1",
        "val_accuracy",
        "val_precision",
        "val_recall",
        "val_ece",
        "val_mce",
        "val_brier_score"
      ],
      "system": [
        "inference_time_ms",
        "memory_usage_mb",
        "gpu_utilization",
        "throughput_samples_per_sec",
        "model_size_mb"
      ]
    },
    "hyperparameters": [
      "model_name",
      "learning_rate",
      "batch_size",
      "optimizer",
      "scheduler",
      "weight_decay",
      "dropout_rate",
      "seed"
    ]
  },
  "target_metrics": {
    "baseline": {
      "min_auc": 0.88,
      "min_accuracy": 0.85,
      "max_loss": 0.5
    },
    "stage_01": {
      "min_auc": 0.90,
      "baseline_improvement_min": 0.03,
      "inference_time_max_ms": 50,
      "calibration_ece_max": 0.05
    },
    "stage_02": {
      "min_auc": 0.92,
      "complementarity_score_min": 0.8,
      "ensemble_improvement_min": 0.02
    }
  },
  "stage_gate_criteria": {
    "technical": {
      "performance_thresholds": true,
      "inference_time_compliance": true,
      "memory_usage_compliance": true,
      "accuracy_targets": true
    },
    "academic": {
      "statistical_significance": 0.05,
      "confidence_interval": 0.95,
      "reproducibility_validation": true,
      "cross_dataset_validation": true
    },
    "system": {
      "mobile_deployment_ready": true,
      "cascade_integration_ready": true,
      "monitoring_coverage": true
    }
  },
  "experiment_templates": {
    "small_scale_validation": {
      "description": "Quick validation - 1000 samples, 10 epochs",
      "n_samples": 1000,
      "n_epochs": 10,
      "batch_size": 32,
      "log_frequency": 1
    },
    "full_training": {
      "description": "Complete training with all datasets",
      "n_epochs": 50,
      "batch_size": 64,
      "log_frequency": 10,
      "save_frequency": 5
    },
    "ablation_study": {
      "description": "Systematic component analysis",
      "track_parameters": true,
      "track_artifacts": true,
      "save_all_configs": true
    }
  },
  "data_management": {
    "dataset_versioning": {
      "enabled": true,
      "hash_algorithm": "md5",
      "track_data_lineage": true,
      "validate_data_integrity": true
    },
    "preprocessing_tracking": {
      "augmentation_parameters": true,
      "normalization_stats": true,
      "class_distribution": true,
      "sampling_strategy": true
    }
  }
}