{
  "metadata": {
    "name": "AWARE-NET Dataset Configuration",
    "description": "Unified dataset configuration for all AWARE-NET training stages",
    "version": "1.0.0",
    "created_at": "2025-09-24",
    "consolidates": [
      "dataset_paths.json",
      "unified_dataset_config.json"
    ]
  },
  "default_settings": {
    "image_format": "jpg",
    "image_size": [256, 256],
    "preprocessing": {
      "resize": [256, 256],
      "normalize": {
        "mean": [0.485, 0.456, 0.406],
        "std": [0.229, 0.224, 0.225]
      }
    },
    "splits": {
      "train_ratio": 0.7,
      "val_ratio": 0.15,
      "test_ratio": 0.15
    }
  },
  "datasets": {
    "celebdf_v2": {
      "name": "CelebDF-v2",
      "description": "CelebDF-v2 - Balanced real/fake celebrity faces",
      "type": "deepfake_detection",
      "enabled": true,
      "paths": {
        "real": "dataset/real/CelebDF-v2",
        "fake": "dataset/fake/CelebDF-v2"
      },
      "manifests": {
        "train": "manifests/celebdf_v2_train.csv",
        "val": "manifests/celebdf_v2_val.csv",
        "test": "manifests/celebdf_v2_test.csv"
      },
      "statistics": {
        "total_samples": 407712,
        "real_samples": 59557,
        "fake_samples": 348155,
        "real_percentage": 14.6,
        "fake_percentage": 85.4,
        "imbalance_ratio": 5.84
      },
      "configurations": {
        "original_imbalanced": {
          "description": "Original CelebDF-v2 with natural imbalance",
          "use_class_weights": true,
          "pos_weight": 5.84,
          "expected_performance": {
            "auc_range": [0.95, 0.999],
            "f1_range": [0.90, 0.99],
            "note": "Path leakage inflates metrics"
          }
        },
        "balanced_clean": {
          "description": "Balanced subset with anonymized filenames",
          "total_samples": 119114,
          "real_samples": 59557,
          "fake_samples": 59557,
          "use_class_weights": false,
          "pos_weight": 1.0,
          "expected_performance": {
            "auc_range": [0.75, 0.85],
            "f1_range": [0.70, 0.82],
            "note": "Realistic performance"
          }
        }
      }
    },
    "faceforensics_plus_plus": {
      "name": "FaceForensics++",
      "description": "FF++ - Multiple fake generation methods",
      "type": "deepfake_detection",
      "enabled": true,
      "weight": 0.35,
      "manifests": {
        "train": "manifests/faceforensics_train.csv",
        "val": "manifests/faceforensics_val.csv",
        "test": "manifests/faceforensics_test.csv"
      },
      "statistics": {
        "total_samples": 745609,
        "real_samples": 161014,
        "fake_samples": 584595,
        "real_percentage": 21.6,
        "fake_percentage": 78.4
      },
      "fake_methods": [
        "Deepfakes",
        "FaceSwap",
        "Face2Face",
        "NeuralTextures"
      ]
    },
    "deeperforensics_1_0": {
      "name": "DeeperForensics-1.0",
      "description": "High quality diverse fake and real data",
      "type": "deepfake_detection",
      "enabled": true,
      "weight": 0.5,
      "manifests": {
        "train": "manifests/deeperforensics_train.csv",
        "val": "manifests/deeperforensics_val.csv",
        "test": "manifests/deeperforensics_test.csv"
      },
      "statistics": {
        "total_samples": 1548061,
        "real_samples": 591572,
        "fake_samples": 956489,
        "real_percentage": 38.2,
        "fake_percentage": 61.8
      }
    },
    "df40": {
      "name": "DF40",
      "description": "DF40 dataset with 9 fake methods",
      "type": "deepfake_detection",
      "enabled": true,
      "statistics": {
        "total_samples": 206662,
        "image_format": "PNG",
        "preprocessed": true,
        "fake_methods": 9
      },
      "manifests": {
        "train": "manifests/df40_train.csv",
        "val": "manifests/df40_val.csv",
        "test": "manifests/df40_test.csv"
      }
    }
  },
  "multi_dataset_configs": {
    "unified_training": {
      "name": "Unified Multi-Dataset Training",
      "description": "Combined training on CelebDF-v2, FF++, and DeeperForensics-1.0",
      "datasets_included": [
        "celebdf_v2",
        "faceforensics_plus_plus",
        "deeperforensics_1_0"
      ],
      "sampling_strategy": {
        "method": "weighted_stratified",
        "balance_datasets": true,
        "balance_classes": true,
        "dataset_weights": {
          "celebdf_v2": 0.15,
          "faceforensics_plus_plus": 0.35,
          "deeperforensics_1_0": 0.5
        }
      },
      "combined_statistics": {
        "total_samples": 2701382,
        "total_real": 812143,
        "total_fake": 1889239,
        "real_percentage": 30.1,
        "fake_percentage": 69.9,
        "class_imbalance_ratio": 2.33
      },
      "class_weights": {
        "real": 2.33,
        "fake": 1.0,
        "auto_calculate": true
      }
    },
    "cross_dataset_validation": {
      "name": "Cross-Dataset Validation",
      "description": "Train on one dataset, test on others",
      "validation_pairs": [
        {
          "train": "celebdf_v2",
          "test": ["faceforensics_plus_plus", "deeperforensics_1_0"]
        },
        {
          "train": "faceforensics_plus_plus",
          "test": ["celebdf_v2", "deeperforensics_1_0"]
        },
        {
          "train": "deeperforensics_1_0",
          "test": ["celebdf_v2", "faceforensics_plus_plus"]
        }
      ]
    }
  },
  "data_loading": {
    "default_config": {
      "batch_size": 32,
      "num_workers": 4,
      "pin_memory": true,
      "drop_last": true,
      "shuffle": true
    },
    "stage_specific": {
      "stage_01_supcon": {
        "min_samples_per_class": 4,
        "balance_sampling": true,
        "contrastive_pairs": true
      },
      "stage_02_experts": {
        "expert_specific_sampling": true,
        "complementarity_aware": true
      }
    }
  },
  "validation_configs": {
    "metrics": [
      "accuracy",
      "auc",
      "f1_score",
      "precision",
      "recall",
      "average_precision",
      "ece",
      "mce",
      "brier_score"
    ],
    "cross_dataset_validation": true,
    "within_dataset_validation": true,
    "bootstrap_samples": 1000,
    "confidence_level": 0.95
  },
  "data_management": {
    "versioning": {
      "enabled": true,
      "hash_algorithm": "md5",
      "track_data_lineage": true,
      "validate_data_integrity": true
    },
    "caching": {
      "enabled": true,
      "cache_preprocessed": true,
      "cache_size_limit_gb": 10
    },
    "augmentation_integration": {
      "apply_during_loading": true,
      "cache_augmented": false,
      "augmentation_policy_reference": "augmentation_policies.json"
    }
  },
  "quick_test_configs": {
    "small_scale_validation": {
      "description": "Quick validation with 1000 samples",
      "sample_size": 1000,
      "real_samples": 500,
      "fake_samples": 500,
      "datasets": ["celebdf_v2"],
      "epochs": 10
    },
    "method_comparison": {
      "description": "Compare different training methods",
      "sample_size": 2000,
      "datasets": ["celebdf_v2", "faceforensics_plus_plus"],
      "balanced": true
    }
  }
}