  "multi_dataset_configs": {
    "unified_training": {
      "name": "Unified Multi-Dataset Training",
      "description": "Combined training on CelebDF-v2, FF++, and DeeperForensics-1.0",
      "datasets_included": [
        "celebdf_v2",
        "faceforensics_plus_plus",
        "deeperforensics_1_0",
        "dfdc"
      ],
      "sampling_strategy": {
        "method": "weighted_stratified",
        "balance_datasets": true,
        "balance_classes": true,
        "auto_calculated": false,
        "dataset_weights": {
          "celebdf_v2": 0.25,
          "faceforensics_plus_plus": 0.25,
          "deeperforensics_1_0": 0.25,
          "dfdc": 0.25
        },
        "note": "Manual equal weights for 4 datasets: 25% each for balanced contribution."
      },
      "combined_statistics": {
        "total_samples": 2701382,
        "total_real": 812143,
        "total_fake": 1889239,
        "real_percentage": 30.1,
        "fake_percentage": 69.9,
        "class_imbalance_ratio": 2.33
      },
      "class_weights": {
        "real": 2.33,
        "fake": 1.0,
        "auto_calculate": true
      }
    },
    "cross_dataset_validation": {
      "name": "Cross-Dataset Validation",
      "description": "Train on one dataset, test on others",
      "validation_pairs": [
        {
          "train": "celebdf_v2",
          "test": [
            "faceforensics_plus_plus",
            "deeperforensics_1_0"
          ]
        },
        {
          "train": "faceforensics_plus_plus",
          "test": [
            "celebdf_v2",
            "deeperforensics_1_0"
          ]
        },
        {
          "train": "deeperforensics_1_0",
          "test": [
            "celebdf_v2",
            "faceforensics_plus_plus"
          ]
        }
      ]
    }
