{
  "metadata": {
    "name": "AWARE-NET Augmentation Policies",
    "description": "Unified data augmentation strategies for all AWARE-NET stages",
    "version": "1.0.0",
    "created_at": "2025-09-24",
    "consolidates": [
      "stage_01/stage1_augmentation.json",
      "stage_02/stage2_augmentation_unified.json",
      "general/dataset_paths.json (augmentation section)",
      "general/unified_dataset_config.json (preprocessing section)"
    ]
  },
  "base_preprocessing": {
    "resize": {
      "target_size": [256, 256],
      "interpolation": "bilinear",
      "maintain_aspect_ratio": false
    },
    "normalize": {
      "mean": [0.485, 0.456, 0.406],
      "std": [0.229, 0.224, 0.225],
      "description": "ImageNet normalization"
    },
    "dtype_conversion": {
      "target_dtype": "float32",
      "scale_range": [0.0, 1.0]
    }
  },
  "augmentation_policies": {
    "baseline_minimal": {
      "description": "Minimal augmentation for baseline models",
      "use_cases": ["stage_00_baseline", "initial_validation"],
      "transforms": [
        {
          "name": "RandomHorizontalFlip",
          "probability": 0.5,
          "order": 1
        },
        {
          "name": "RandomRotation",
          "degrees": [-10, 10],
          "probability": 0.3,
          "order": 2
        },
        {
          "name": "ColorJitter",
          "brightness": 0.2,
          "contrast": 0.2,
          "saturation": 0.2,
          "hue": 0.1,
          "probability": 0.5,
          "order": 3
        },
        {
          "name": "GaussianBlur",
          "kernel_size": 5,
          "sigma": [0.1, 2.0],
          "probability": 0.3,
          "order": 4
        }
      ]
    },
    "contrastive_learning": {
      "description": "Strong augmentations optimized for SupCon contrastive learning",
      "use_cases": ["stage_01_supcon"],
      "motivation": "Strong augmentations help learn invariant features",
      "transforms": [
        {
          "name": "RandomResizedCrop",
          "size": 256,
          "scale": [0.8, 1.0],
          "ratio": [0.9, 1.1],
          "probability": 1.0,
          "order": 1
        },
        {
          "name": "RandomHorizontalFlip",
          "probability": 0.5,
          "order": 2
        },
        {
          "name": "ColorJitter",
          "brightness": 0.4,
          "contrast": 0.4,
          "saturation": 0.4,
          "hue": 0.1,
          "probability": 0.8,
          "order": 3
        },
        {
          "name": "RandomGrayscale",
          "probability": 0.2,
          "order": 4
        },
        {
          "name": "GaussianBlur",
          "kernel_size": [3, 23],
          "sigma": [0.1, 2.0],
          "probability": 0.5,
          "order": 5
        },
        {
          "name": "RandomApply",
          "transforms": ["GaussianBlur"],
          "probability": 0.5,
          "order": 6
        }
      ],
      "consistency_regularization": {
        "enabled": true,
        "alpha": 0.1,
        "description": "Consistency loss between augmented views"
      }
    },
    "spatial_expert": {
      "description": "Augmentations optimized for spatial artifact detection",
      "use_cases": ["stage_02_spatial_expert"],
      "preserve_spatial_features": true,
      "transforms": [
        {
          "name": "RandomHorizontalFlip",
          "probability": 0.5,
          "order": 1
        },
        {
          "name": "RandomRotation",
          "degrees": 5.0,
          "probability": 0.3,
          "order": 2
        },
        {
          "name": "RandomAffine",
          "scale_range": [0.9, 1.0],
          "shear_range": [-2, 2],
          "probability": 0.3,
          "order": 3
        },
        {
          "name": "ColorJitter",
          "brightness": 0.1,
          "contrast": 0.1,
          "saturation": 0.1,
          "hue": 0.05,
          "probability": 0.4,
          "order": 4
        },
        {
          "name": "GaussianNoise",
          "std": 0.01,
          "probability": 0.3,
          "order": 5
        },
        {
          "name": "MotionBlur",
          "limit": 3,
          "probability": 0.2,
          "order": 6
        },
        {
          "name": "JpegCompression",
          "quality_range": [85, 100],
          "probability": 0.3,
          "order": 7
        }
      ],
      "edge_preservation_ratio": 0.9,
      "texture_consistency_check": true
    },
    "generative_expert": {
      "description": "Augmentations optimized for generative structure detection",
      "use_cases": ["stage_02_genconvit_expert"],
      "preserve_generative_patterns": true,
      "transforms": [
        {
          "name": "RandomHorizontalFlip",
          "probability": 0.5,
          "order": 1
        },
        {
          "name": "RandomRotation",
          "degrees": 7.5,
          "probability": 0.4,
          "order": 2
        },
        {
          "name": "RandomAffine",
          "scale_range": [0.85, 1.05],
          "shear_range": [-3, 3],
          "probability": 0.4,
          "order": 3
        },
        {
          "name": "ColorJitter",
          "brightness": 0.12,
          "contrast": 0.12,
          "saturation": 0.12,
          "hue": 0.06,
          "probability": 0.5,
          "order": 4
        },
        {
          "name": "GaussianNoise",
          "std": 0.015,
          "probability": 0.4,
          "order": 5
        },
        {
          "name": "MotionBlur",
          "limit": 5,
          "probability": 0.25,
          "order": 6
        },
        {
          "name": "JpegCompression",
          "quality_range": [80, 100],
          "probability": 0.35,
          "order": 7
        },
        {
          "name": "ElasticTransform",
          "alpha": 1.0,
          "sigma": 50.0,
          "probability": 0.2,
          "order": 8
        }
      ],
      "latent_space_preservation": true,
      "reconstruction_consistency": true
    },
    "temporal_expert": {
      "description": "Augmentations for temporal consistency analysis",
      "use_cases": ["stage_03_temporal_expert"],
      "status": "planned",
      "preserve_temporal_coherence": true,
      "transforms": [
        {
          "name": "TemporalJitter",
          "max_offset": 2,
          "probability": 0.3
        },
        {
          "name": "TemporalDropout",
          "dropout_rate": 0.1,
          "probability": 0.2
        },
        {
          "name": "MotionAugmentation",
          "velocity_range": [-2, 2],
          "probability": 0.3
        }
      ]
    },
    "mobile_optimized": {
      "description": "Lightweight augmentations for mobile deployment",
      "use_cases": ["mobile_deployment", "edge_devices"],
      "computational_efficiency": "high",
      "transforms": [
        {
          "name": "RandomHorizontalFlip",
          "probability": 0.5,
          "order": 1
        },
        {
          "name": "RandomBrightness",
          "brightness": 0.1,
          "probability": 0.3,
          "order": 2
        },
        {
          "name": "RandomContrast",
          "contrast": 0.1,
          "probability": 0.3,
          "order": 3
        }
      ],
      "fast_execution": true,
      "memory_efficient": true
    }
  },
  "stage_specific_mappings": {
    "stage_00": "baseline_minimal",
    "stage_01": "contrastive_learning",
    "stage_02_spatial": "spatial_expert",
    "stage_02_generative": "generative_expert",
    "stage_03": "temporal_expert",
    "mobile_deployment": "mobile_optimized"
  },
  "augmentation_scheduling": {
    "progressive_augmentation": {
      "enabled": false,
      "start_policy": "baseline_minimal",
      "end_policy": "contrastive_learning",
      "transition_epochs": 10
    },
    "curriculum_learning": {
      "enabled": false,
      "difficulty_progression": [
        "baseline_minimal",
        "spatial_expert",
        "contrastive_learning"
      ]
    }
  },
  "validation_augmentation": {
    "test_time_augmentation": {
      "enabled": false,
      "num_augmentations": 5,
      "aggregation_method": "mean",
      "policies": ["baseline_minimal"]
    },
    "robustness_testing": {
      "enabled": true,
      "stress_test_policies": [
        "heavy_compression",
        "extreme_lighting",
        "geometric_distortion"
      ]
    }
  },
  "specialized_policies": {
    "heavy_compression": {
      "description": "Test robustness to heavy compression",
      "transforms": [
        {
          "name": "JpegCompression",
          "quality_range": [20, 60],
          "probability": 1.0
        }
      ]
    },
    "extreme_lighting": {
      "description": "Test robustness to lighting changes",
      "transforms": [
        {
          "name": "ColorJitter",
          "brightness": 0.6,
          "contrast": 0.6,
          "probability": 1.0
        }
      ]
    },
    "geometric_distortion": {
      "description": "Test robustness to geometric distortions",
      "transforms": [
        {
          "name": "RandomRotation",
          "degrees": [-30, 30],
          "probability": 1.0
        },
        {
          "name": "RandomAffine",
          "scale_range": [0.7, 1.3],
          "shear_range": [-10, 10],
          "probability": 1.0
        }
      ]
    }
  },
  "implementation_guidelines": {
    "execution_order": "Apply transforms in specified order",
    "probability_handling": "Independent probability for each transform",
    "consistency": "Use same random seed for paired samples in contrastive learning",
    "performance": "Cache transformed images when possible",
    "memory_management": "Apply transforms on-the-fly during data loading"
  },
  "ablation_studies": {
    "augmentation_impact": {
      "baseline_vs_augmented": true,
      "individual_transform_contribution": true,
      "optimal_probability_search": true
    },
    "stage_specific_optimization": {
      "supcon_augmentation_sensitivity": true,
      "spatial_expert_preservation": true,
      "generative_expert_consistency": true
    }
  }
}