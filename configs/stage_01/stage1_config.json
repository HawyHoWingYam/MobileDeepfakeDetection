{
  "metadata": {
    "stage": "stage_01",
    "name": "SupCon_RapidFilter",
    "version": "1.0.0",
    "description": "SupCon-based rapid filtering system for authenticity modeling",
    "created_at": "2025-09-22",
    "paradigm": "authenticity_modeling"
  },
  "model": {
    "architecture": "MobileNetV4-Hybrid-Medium",
    "backbone": "mobilenetv4_hybrid_medium",
    "pretrained": true,
    "num_classes": 2,
    "projection_dim": 512,
    "dropout_rate": 0.2,
    "freeze_backbone": false
  },
  "loss": {
    "type": "SupConLoss",
    "temperature": 0.07,
    "base_temperature": 0.07,
    "contrast_mode": "all",
    "numerical_stability": true
  },
  "training": {
    "optimizer": "AdamW",
    "learning_rate": 1e-3,
    "weight_decay": 1e-4,
    "batch_size": 32,
    "epochs": 50,
    "warmup_epochs": 5,
    "scheduler": "CosineAnnealingLR",
    "gradient_clipping": 1.0,
    "mixed_precision": true
  },
  "data": {
    "image_size": [256, 256],
    "normalize": {
      "mean": [0.485, 0.456, 0.406],
      "std": [0.229, 0.224, 0.225]
    },
    "augmentation_policy": "contrastive_learning",
    "min_samples_per_class": 4,
    "balance_sampling": true
  },
  "calibration": {
    "method": "temperature_scaling",
    "search_range": [0.1, 5.0],
    "search_steps": 100,
    "validation_split": 0.2
  },
  "cascade": {
    "conservative_threshold": {
      "high_confidence": 0.99,
      "low_confidence": 0.01,
      "filter_rate_target": 0.90,
      "false_negative_rate_max": 0.05
    }
  },
  "performance": {
    "inference_time_target_ms": 50,
    "memory_limit_gb": 2,
    "mobile_compatibility": true,
    "quantization_ready": true
  },
  "experiment": {
    "seed": 42,
    "deterministic": true,
    "reproducible": true,
    "logging_level": "INFO",
    "save_frequency": 5,
    "early_stopping": {
      "patience": 10,
      "monitor": "val_auc",
      "mode": "max",
      "min_delta": 0.001
    }
  },
  "stage_gate": {
    "technical": {
      "min_auc": 0.90,
      "baseline_improvement_min": 0.03,
      "inference_time_max_ms": 50,
      "memory_max_gb": 2,
      "calibration_ece_max": 0.05
    },
    "academic": {
      "statistical_significance": 0.05,
      "confidence_interval": 0.95,
      "cross_dataset_validation": true,
      "feature_space_analysis": true
    },
    "system": {
      "cascade_filter_rate_min": 0.90,
      "false_negative_rate_max": 0.05,
      "mobile_deployment_ready": true,
      "package_size_max_mb": 50
    }
  }
}