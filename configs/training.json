{
  "metadata": {
    "name": "AWARE-NET Stage 00 Training Configuration",
    "description": "Simplified training config for baseline model",
    "version": "1.0.0"
  },

  "experiment": {
    "name": "baseline_4dataset_balanced_b0",
    "description": "EfficientNetV2-B0 baseline with 4 balanced datasets (CelebDF, FF++, DeeperForensics, DFDC)",
    "tags": ["baseline", "efficientnet", "stage0", "multi-dataset", "balanced"]
  },

  "model": {
    "name": "tf_efficientnetv2_b0",
    "pretrained": true,
    "dropout_rate": 0.2,
    "freeze_backbone": false
  },

  "training": {
    "batch_size": 256,
    "epochs": 5,
    "learning_rate": 0.003,
    "weight_decay": 0.0001,
    "optimizer": "adamw",
    "scheduler": "cosine",
    "num_workers": 16,
    "mixed_precision": true,
    "early_stopping_patience": 8,
    "gradient_clipping": 1.0,
    "warmup_epochs": 5,
    "use_class_weights": false,
    "comment": "RTX 5090 + B0 optimized: batch_size=256 (8x), lr=0.003 (3x), workers=16 (4x), epochs=5"
  },

  "data": {
    "dataset_config": "configs/datasets.json",
    "dataset_name": "celebdf_v2",
    "dataset_mode": "balanced",
    "multi_dataset": true,
    "use_dataset_weights": true,
    "strict_batch_balance": true,
    "image_size": 256,
    "augmentation": true,
    "subset_ratio": 1.0,
    "comment": "dataset_mode: 'balanced' (50/50 class balance). use_dataset_weights: equal 25% per dataset. strict_batch_balance: enforce exact 64-sample batches"
  },

  "monitoring": {
    "log_interval": 100,
    "save_interval": 5,
    "eval_interval": 1,
    "save_best_only": true,
    "monitor_metric": "val_auc"
  },

  "paths": {
    "models_dir": "models/stage_00",
    "results_dir": "results/stage_00",
    "logs_dir": "logs/stage_00",
    "experiments_dir": "experiments"
  },

  "targets": {
    "min_auc": 0.88,
    "min_f1": 0.85,
    "max_inference_time_ms": 100,
    "max_memory_usage_gb": 4
  }
}