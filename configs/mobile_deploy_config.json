{
  "metadata": {
    "name": "Stage01_Mobile_Deployment",
    "description": "Mobile deployment optimization configuration for Stage 1 SupCon rapid filter",
    "version": "1.0.0",
    "target_platforms": ["Android", "iOS", "Edge Devices"]
  },
  "performance_targets": {
    "inference_time": {
      "max_ms_per_image": 50,
      "target_ms_per_image": 30,
      "measurement_conditions": "Single image, warm model, mobile CPU"
    },
    "memory_usage": {
      "max_peak_mb": 2048,
      "target_peak_mb": 1536,
      "model_size_max_mb": 50,
      "model_size_target_mb": 30
    },
    "throughput": {
      "min_images_per_second": 20,
      "target_images_per_second": 33
    },
    "accuracy_retention": {
      "min_auc_retention": 0.95,
      "target_auc_retention": 0.98,
      "calibration_ece_max": 0.08
    }
  },
  "model_optimization": {
    "quantization": {
      "enabled": true,
      "method": "post_training_quantization",
      "precision": "int8",
      "calibration_dataset_size": 1000,
      "preserve_accuracy": true,
      "quantization_aware_training": false
    },
    "pruning": {
      "enabled": true,
      "method": "magnitude_based",
      "sparsity_target": 0.3,
      "structured_pruning": false,
      "fine_tune_after_pruning": true,
      "preserve_projection_head": true
    },
    "knowledge_distillation": {
      "enabled": false,
      "teacher_model": "full_precision",
      "student_model": "quantized",
      "temperature": 4.0,
      "alpha": 0.7
    },
    "layer_optimization": {
      "fuse_batch_norm": true,
      "fuse_relu": true,
      "optimize_conv_bn": true,
      "channel_shuffle_optimization": true
    }
  },
  "architecture_modifications": {
    "input_optimization": {
      "input_size": [256, 256],
      "alternative_sizes": [[224, 224], [192, 192]],
      "channel_first": true,
      "preprocessing_fusion": true
    },
    "backbone_modifications": {
      "use_separable_conv": true,
      "reduce_intermediate_channels": false,
      "optimize_activation_functions": true,
      "use_mobile_optimized_blocks": true
    },
    "head_optimization": {
      "projection_head": {
        "reduce_dimensions": true,
        "alternative_dims": [256, 128],
        "use_lightweight_mlp": true
      },
      "classification_head": {
        "simplified_architecture": true,
        "merge_with_projection": false
      }
    }
  },
  "deployment_formats": {
    "onnx": {
      "enabled": true,
      "opset_version": 14,
      "optimize_for_mobile": true,
      "dynamic_axes": false,
      "export_params": true
    },
    "torchscript": {
      "enabled": true,
      "optimization_level": 3,
      "mobile_optimization": true,
      "quantized_export": true
    },
    "tensorflow_lite": {
      "enabled": false,
      "converter_optimizations": ["DEFAULT"],
      "target_spec": {
        "supported_ops": ["TFLITE_BUILTINS"],
        "supported_types": ["float16"]
      }
    },
    "coreml": {
      "enabled": false,
      "minimum_deployment_target": "iOS13",
      "compute_units": "ALL",
      "precision": "float16"
    }
  },
  "cascade_mobile_optimization": {
    "threshold_strategy": {
      "mobile_optimized_thresholds": true,
      "reduced_precision_thresholds": false,
      "adaptive_thresholds": false
    },
    "decision_routing": {
      "early_exit_optimization": true,
      "batch_processing_disabled": true,
      "single_image_optimization": true
    },
    "feature_extraction": {
      "on_demand_features": true,
      "cached_features": false,
      "compressed_features": true
    }
  },
  "device_profiles": {
    "high_end_mobile": {
      "description": "Flagship smartphones (iPhone 14+, Galaxy S23+)",
      "performance_targets": {
        "inference_time_ms": 25,
        "memory_mb": 1024,
        "model_size_mb": 40
      },
      "optimizations": {
        "quantization": "int8",
        "pruning_sparsity": 0.2,
        "input_size": [256, 256]
      }
    },
    "mid_range_mobile": {
      "description": "Mid-range smartphones",
      "performance_targets": {
        "inference_time_ms": 40,
        "memory_mb": 1536,
        "model_size_mb": 30
      },
      "optimizations": {
        "quantization": "int8",
        "pruning_sparsity": 0.4,
        "input_size": [224, 224]
      }
    },
    "edge_device": {
      "description": "Embedded devices, IoT cameras",
      "performance_targets": {
        "inference_time_ms": 50,
        "memory_mb": 512,
        "model_size_mb": 20
      },
      "optimizations": {
        "quantization": "int8",
        "pruning_sparsity": 0.5,
        "input_size": [192, 192],
        "reduce_projection_dim": 128
      }
    }
  },
  "benchmarking": {
    "profiling_tools": {
      "pytorch_profiler": true,
      "onnx_runtime_profiler": true,
      "mobile_device_profiling": true
    },
    "benchmark_datasets": {
      "synthetic_data": {
        "enabled": true,
        "batch_sizes": [1, 4, 8],
        "input_sizes": [[192, 192], [224, 224], [256, 256]]
      },
      "real_data_subset": {
        "enabled": true,
        "sample_size": 100,
        "representative_distribution": true
      }
    },
    "performance_metrics": {
      "latency_percentiles": [50, 95, 99],
      "memory_peak_tracking": true,
      "energy_consumption": false,
      "accuracy_degradation": true
    }
  },
  "validation_pipeline": {
    "optimization_validation": {
      "accuracy_regression_test": true,
      "performance_benchmark": true,
      "numerical_stability_check": true,
      "calibration_preservation": true
    },
    "deployment_testing": {
      "format_compatibility": true,
      "device_compatibility": false,
      "end_to_end_testing": true
    },
    "stage_gate_mobile_criteria": {
      "inference_time_compliance": true,
      "memory_usage_compliance": true,
      "accuracy_retention_check": true,
      "cascade_functionality_preserved": true
    }
  },
  "monitoring_and_debugging": {
    "performance_monitoring": {
      "runtime_profiling": true,
      "memory_leak_detection": true,
      "thermal_throttling_monitoring": false
    },
    "accuracy_monitoring": {
      "prediction_distribution_tracking": true,
      "confidence_score_monitoring": true,
      "cascade_decision_tracking": true
    },
    "debugging_tools": {
      "layer_output_inspection": false,
      "gradient_flow_analysis": false,
      "optimization_step_tracking": true
    }
  },
  "deployment_pipeline": {
    "automated_optimization": {
      "grid_search_optimization": true,
      "automated_pruning": true,
      "automated_quantization": true,
      "pareto_frontier_analysis": true
    },
    "packaging": {
      "model_bundle_creation": true,
      "config_inclusion": true,
      "calibration_table_inclusion": true,
      "documentation_generation": true
    },
    "distribution": {
      "model_hub_upload": false,
      "artifact_versioning": true,
      "deployment_ready_packages": true
    }
  },
  "fallback_strategies": {
    "performance_fallbacks": {
      "reduce_input_resolution": true,
      "increase_quantization_aggressiveness": true,
      "simplify_architecture": true,
      "reduce_cascade_features": true
    },
    "accuracy_fallbacks": {
      "reduce_optimization_aggressiveness": true,
      "use_knowledge_distillation": true,
      "fine_tune_optimized_model": true,
      "hybrid_precision": true
    }
  },
  "mobile_specific_features": {
    "platform_optimizations": {
      "android_nnapi": false,
      "ios_core_ml": false,
      "arm_neon": true,
      "gpu_acceleration": false
    },
    "deployment_considerations": {
      "app_size_impact": true,
      "cold_start_optimization": true,
      "background_processing": false,
      "real_time_inference": true
    }
  }
}