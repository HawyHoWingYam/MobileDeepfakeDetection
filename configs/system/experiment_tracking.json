{
  "metadata": {
    "name": "Stage01_Experiment_Tracking",
    "description": "Experiment tracking configuration for AWARE-NET Stage 1 SupCon implementation",
    "version": "1.0.0",
    "created_for": "Academic reproducibility and stage-gate validation"
  },
  "experiment_tracking": {
    "enabled": true,
    "primary_tracker": "wandb",
    "fallback_tracker": "mlflow",
    "local_logging": true
  },
  "wandb_config": {
    "project": "AWARE-NET-Stage01",
    "entity": null,
    "group": "SupCon-Authenticity-Modeling",
    "job_type": "stage01-training",
    "tags": [
      "supcon",
      "authenticity-modeling",
      "mobilenetv4",
      "deepfake-detection",
      "academic-research",
      "stage-01"
    ],
    "config": {
      "track_gradients": true,
      "track_parameters": true,
      "track_artifacts": true,
      "save_code": true,
      "monitor_gpu": true,
      "log_frequency": 10
    },
    "artifacts": {
      "model_checkpoints": true,
      "config_files": true,
      "evaluation_reports": true,
      "calibration_results": true,
      "feature_visualizations": true
    }
  },
  "mlflow_config": {
    "tracking_uri": "file:./mlruns",
    "experiment_name": "AWARE-NET-Stage01-SupCon",
    "run_name_pattern": "stage01_{timestamp}_{config_hash}",
    "artifact_location": "./mlflow_artifacts",
    "config": {
      "log_system_metrics": true,
      "log_model_summary": true,
      "log_artifacts": true,
      "auto_log": false
    }
  },
  "logging_schema": {
    "metrics": {
      "training": [
        "epoch",
        "step",
        "learning_rate",
        "supcon_loss",
        "classification_loss",
        "total_loss",
        "gradient_norm",
        "batch_time",
        "data_loading_time"
      ],
      "validation": [
        "val_auc",
        "val_f1",
        "val_accuracy",
        "val_precision",
        "val_recall",
        "val_ece",
        "val_mce",
        "val_brier_score",
        "feature_separation_score"
      ],
      "cascade": [
        "filter_rate",
        "local_processing_rate",
        "false_negative_rate",
        "cascade_accuracy",
        "decision_confidence_mean",
        "decision_confidence_std"
      ],
      "system": [
        "inference_time_ms",
        "memory_usage_mb",
        "gpu_utilization",
        "throughput_samples_per_sec",
        "model_size_mb"
      ]
    },
    "hyperparameters": [
      "model_name",
      "projection_dim",
      "temperature",
      "learning_rate",
      "batch_size",
      "optimizer",
      "scheduler",
      "weight_decay",
      "dropout_rate",
      "augmentation_policy",
      "min_samples_per_class",
      "seed"
    ],
    "stage_gate_criteria": [
      "technical_gates_passed",
      "academic_gates_passed",
      "system_gates_passed",
      "baseline_improvement_auc",
      "meets_inference_time_target",
      "meets_memory_target",
      "meets_calibration_target",
      "meets_filter_rate_target"
    ]
  },
  "reproducibility": {
    "seed_policy": {
      "global_seed": 42,
      "deterministic_algorithms": true,
      "benchmark_mode": false,
      "numpy_seed": 42,
      "random_seed": 42,
      "torch_manual_seed": 42,
      "cuda_manual_seed": 42,
      "cuda_manual_seed_all": 42
    },
    "environment_tracking": {
      "python_version": true,
      "pytorch_version": true,
      "cuda_version": true,
      "gpu_info": true,
      "system_info": true,
      "package_versions": [
        "torch",
        "timm",
        "sklearn",
        "numpy",
        "pandas",
        "matplotlib",
        "seaborn",
        "albumentations",
        "opencv-python"
      ]
    }
  },
  "artifact_management": {
    "model_checkpoints": {
      "save_frequency": 5,
      "save_best_only": false,
      "save_top_k": 3,
      "monitor_metric": "val_auc",
      "mode": "max",
      "filename_pattern": "stage01_epoch_{epoch:02d}_auc_{val_auc:.4f}.pth"
    },
    "evaluation_artifacts": {
      "confusion_matrices": true,
      "roc_curves": true,
      "pr_curves": true,
      "calibration_plots": true,
      "feature_space_visualizations": true,
      "threshold_analysis_plots": true
    },
    "configuration_snapshots": {
      "model_config": true,
      "training_config": true,
      "data_config": true,
      "experiment_config": true
    }
  },
  "notification_config": {
    "enabled": false,
    "channels": {
      "email": {
        "enabled": false,
        "recipients": [],
        "events": ["experiment_complete", "stage_gate_failure"]
      },
      "slack": {
        "enabled": false,
        "webhook_url": null,
        "events": ["experiment_complete", "stage_gate_failure", "improvement_detected"]
      }
    }
  },
  "experiment_templates": {
    "small_scale_validation": {
      "description": "Critical decision gate - 1000 samples, 10 epochs",
      "config_overrides": {
        "n_samples": 1000,
        "n_epochs": 10,
        "batch_size": 32,
        "track_gradients": false,
        "log_frequency": 1
      },
      "required_metrics": [
        "val_auc",
        "baseline_improvement_auc",
        "statistical_significance"
      ]
    },
    "full_training": {
      "description": "Complete Stage 1 training with all datasets",
      "config_overrides": {
        "n_epochs": 50,
        "batch_size": 64,
        "track_gradients": true,
        "log_frequency": 10,
        "save_frequency": 5
      },
      "required_metrics": [
        "val_auc",
        "val_ece",
        "filter_rate",
        "inference_time_ms",
        "memory_usage_mb"
      ]
    },
    "ablation_study": {
      "description": "Systematic component ablation analysis",
      "config_overrides": {
        "track_parameters": true,
        "track_artifacts": true,
        "save_all_configs": true
      },
      "sweep_parameters": [
        "temperature",
        "projection_dim",
        "learning_rate",
        "batch_size"
      ]
    }
  },
  "data_management": {
    "dataset_versioning": {
      "enabled": true,
      "hash_algorithm": "md5",
      "track_data_lineage": true,
      "validate_data_integrity": true
    },
    "preprocessing_tracking": {
      "augmentation_parameters": true,
      "normalization_stats": true,
      "class_distribution": true,
      "sampling_strategy": true
    }
  },
  "academic_requirements": {
    "statistical_analysis": {
      "confidence_intervals": true,
      "significance_tests": true,
      "effect_size_calculation": true,
      "multiple_testing_correction": true
    },
    "reproducibility_standards": {
      "code_versioning": true,
      "data_versioning": true,
      "environment_specification": true,
      "random_seed_documentation": true
    },
    "publication_artifacts": {
      "result_tables": true,
      "figure_generation": true,
      "supplementary_materials": true,
      "methodology_documentation": true
    }
  }
}